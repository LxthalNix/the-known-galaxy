---
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { resolve, sep } from 'node:path';
import { eras } from '../../data/eras';
import { formatPerspectiveDate } from '../../utils/lore-calendar';
import { safeLoreHtml } from '../../utils/safe-html';
import css from '../../styles/global.css?inline';
import archiveCss from '../../styles/experiment/concepts.css?inline';

export async function getStaticPaths() {
  if (process.env.LORE_REVIEW_PREVIEWS !== '1') return [];
  const entries = await getCollection('events', ({ data }) => !data.draft && !data.demo);
  const accounts = await getCollection('perspectives', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.data.slug }, props: { entry, accounts: accounts.filter(account => account.data.event === entry.data.slug) } }));
}
const { entry, accounts } = Astro.props;
const event = entry.data;
const era = eras.find(e => e.id === event.era);
const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
async function embeddedImage(image: string) {
  const publicRoot = resolve('public'), imagePath = resolve(publicRoot, image.replace(/^\//, ''));
  if (!imagePath.startsWith(publicRoot + sep)) throw new Error('Preview image escapes public/.');
  const extension = imagePath.split('.').pop()?.toLowerCase();
  const mime = extension === 'webp' ? 'image/webp' : extension === 'png' ? 'image/png' : extension === 'jpg' || extension === 'jpeg' ? 'image/jpeg' : '';
  if (!mime) throw new Error('Review images must be PNG, JPEG, or WebP.');
  return `data:${mime};base64,${(await readFile(imagePath)).toString('base64')}`;
}
const images = await Promise.all([...(event.image ? [{ image: event.image, alt: event.imageAlt ?? event.title }] : []), ...(event.gallery ?? [])].map(async image => ({ ...image, source: await embeddedImage(image.image) })));
const fonts = [
  ['Ubuntu', 400, 'ubuntu/ubuntu-regular.ttf'], ['Ubuntu', 500, 'ubuntu/ubuntu-medium.ttf'], ['Ubuntu', 700, 'ubuntu/ubuntu-bold.ttf'],
  ['Source Serif 4', 400, 'source-serif/source-serif-0.ttf'], ['Source Serif 4', 600, 'source-serif/source-serif-1.ttf'],
] as const;
const fontCss = (await Promise.all(fonts.map(async ([family, weight, file]) => `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};src:url(data:font/ttf;base64,${(await readFile(resolve('public/fonts', file))).toString('base64')}) format('truetype');}`))).join('');
const offlineHtml = (html: string) => safeLoreHtml(html).replace(/<img\b[^>]*>/g, '<p>[Inline article image: check this asset in the pull request.]</p>');
const html = offlineHtml(entry.rendered?.html ?? '');
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Review: {event.title}</title><style is:inline set:html={css + archiveCss + fontCss}></style>
  <style is:inline>body{margin:0;padding:24px}.review-header{max-width:1200px;margin:0 auto 24px}.review-header p{font-size:14px;line-height:1.7;color:#aebbc8}.archive-record{margin:0 auto;padding-top:24px}.archive-record-heading h1{font:400 clamp(28px,3.2vw,46px)/1.13 var(--display);margin:16px 0 14px;text-wrap:balance}.review-gallery{margin:0;max-width:1050px}.review-gallery img{display:block;width:100%;max-height:540px;object-fit:contain;background:#0a1119;border-radius:6px}.review-gallery figcaption{font-size:13px;line-height:1.6;color:#aebbc8;margin-top:10px}.review-filmstrip{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:20px;max-width:1050px}.review-filmstrip img{height:180px}.review-account{border-top:1px solid #2b3743;padding-block:24px}.review-account summary{cursor:pointer;min-height:44px;line-height:44px}.review-account h3{font-family:var(--display);font-size:26px}@media(max-width:700px){body{padding:16px}.archive-record{padding-inline:0}}</style></head>
  <body class="experiment concept-a">
    <header class="review-header"><p>Editorial preview · not yet published</p><p>Review the canonical article, optional faction accounts, chronology and imagery. Images and fonts are embedded for offline viewing. Click gallery images to open full size. Inline article images must still be checked in the pull request. {event.submissionIssue && <a href={`https://github.com/LxthalNix/the-known-galaxy/issues/${event.submissionIssue}`}>Open submission and sources ↗</a>}</p></header>
    <main class="archive-record">
      <header class="archive-record-heading"><div class="record-date-row"><span class="record-date">{event.year} {event.calendar} · {formatPerspectiveDate(event.year, event.calendar, 'jedi')}</span><span>{event.factions.map(capitalize).join(' & ')}</span></div><h1>{event.title}</h1><p class="account-status">Canonical account</p></header>
      <div class="archive-record-composition">
        {images[0] && <figure class="review-gallery"><a href={images[0].source} target="_blank" rel="noopener"><img src={images[0].source} alt={images[0].alt} /></a>{images[0].caption && <figcaption>{images[0].caption}</figcaption>}</figure>}
        {images.length > 1 && <div class="review-filmstrip">{images.slice(1).map(image => <figure class="review-gallery"><a href={image.source} target="_blank" rel="noopener"><img src={image.source} alt={image.alt} /></a>{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>}
        <article class="archive-record-narrative"><p class="record-summary">{event.summary}</p><div class="lore-body" set:html={html}></div>
          {accounts.map(account => <details class="review-account"><summary>{capitalize(account.data.perspective)} account</summary><h3>{account.data.title ?? event.title}</h3><p class="record-summary">{account.data.summary ?? event.summary}</p><div class="lore-body" set:html={offlineHtml(account.rendered?.html ?? '')}></div>{account.data.terminology && <dl class="account-terminology">{Object.entries(account.data.terminology).map(([term, meaning]) => <div><dt>{term}</dt><dd>{meaning}</dd></div>)}</dl>}</details>)}
        </article>
      </div>
      <div class="archive-record-foot"><dl class="record-metadata"><div><dt>Era</dt><dd>{era?.name}</dd></div><div><dt>Classification</dt><dd>{event.types.map(capitalize).join(' · ')}</dd></div><div><dt>Significance</dt><dd>{capitalize(event.importance)}</dd></div><div><dt>Locations</dt><dd>{event.locations.join(' · ') || 'Not recorded'}</dd></div><div><dt>Characters</dt><dd>{event.characters.join(' · ') || 'Not recorded'}</dd></div><div><dt>Related slugs</dt><dd>{event.relatedEvents.join(' · ') || 'None'}</dd></div><div><dt>Same-year order (review only)</dt><dd>{event.timelineOrder}</dd></div></dl></div>
    </main>
  </body>
</html>
