---
import { getCollection } from 'astro:content';
import TimelineArchive from '../components/timeline/TimelineArchive';
import { compareEvents } from '../utils/chronology';
import { withBase, contentWithBase } from '../utils/paths';
import type { LoreEvent } from '../types/events';
import '../styles/global.css';

const entries = await getCollection('events', ({ data }) => !data.draft);
const slugs = new Set<string>();
for (const entry of entries) {
  if (slugs.has(entry.data.slug)) throw new Error(`Duplicate event slug: ${entry.data.slug}`);
  slugs.add(entry.data.slug);
}
for (const entry of entries) {
  for (const related of entry.data.relatedEvents) {
    if (!slugs.has(related) || related === entry.data.slug) throw new Error(`Invalid relatedEvents in ${entry.data.slug}: ${related}. References must identify another published event.`);
  }
}
const base = import.meta.env.BASE_URL;
const events: LoreEvent[] = entries.map((entry) => ({
  ...entry.data,
  html: contentWithBase(entry.rendered?.html ?? '', base),
  searchText: [entry.data.title, entry.data.summary, ...entry.data.characters, ...entry.data.locations, ...entry.data.types, entry.body ?? ''].join(' ').toLocaleLowerCase(),
})).sort(compareEvents);
const canonical = new URL(withBase('', base), Astro.site);
const description = 'Explore the defining moments of The Known Galaxy, an alternate Star Wars chronology. An interactive BBD / ABD lore archive for the Roblox community.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Known Galaxy — Lore Archive" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg', base)} />
    <title>The Known Galaxy — Lore Timeline</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to archive</a>
    <TimelineArchive events={events} base={base} client:load />
    <noscript><section class="noscript-records"><h2>Known history</h2><p>Enable JavaScript for search, filters, and interactive record selection. The approved records are available below.</p>{events.map((event) => <article><h3>{event.year} {event.calendar} — {event.title}</h3><div set:html={event.html} /></article>)}</section></noscript>
  </body>
</html>
