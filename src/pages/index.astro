---
import { getCollection } from 'astro:content';
import TimelineExperiment from '../components/experiment/TimelineExperiment';
import { experimentalContent } from '../utils/experimental-content';
import { currentCanonicalDate } from '../utils/canonical-calendar';
import { withBase } from '../utils/paths';
import '../styles/global.css';
import '../styles/archive-fonts.css';
import '../styles/experiment/concepts.css';

const entries = await getCollection('events', ({ data }) => !data.draft && !data.demo);
const slugs = new Set<string>();
for (const entry of entries) {
  if (slugs.has(entry.data.slug)) throw new Error(`Duplicate event slug: ${entry.data.slug}`);
  slugs.add(entry.data.slug);
}
for (const entry of entries) {
  for (const related of entry.data.relatedEvents) {
    if (!slugs.has(related) || related === entry.data.slug) throw new Error(`Invalid relatedEvents in ${entry.data.slug}: ${related}. References must identify another published event.`);
  }
}
const base = import.meta.env.BASE_URL;
const { events, accounts } = await experimentalContent(base);
const initialDate = currentCanonicalDate();
const canonical = new URL(withBase('', base), Astro.site);
const description = 'Explore the defining moments of The Known Galaxy. One community lore chronology, viewed through the Jedi BDO / ADO or Sith BBD / ABD calendar.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Known Galaxy — Lore Archive" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg', base)} />
    <title>The Known Galaxy — Lore Timeline</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to archive</a>
    <TimelineExperiment events={events} fixtures={[]} accounts={accounts} concept="a" base={base} initialDate={initialDate} experimental={false} client:load />
    <noscript><section class="noscript-records"><h2>Known history</h2><p>Enable JavaScript for search, filters, and interactive record selection. The approved records are available below.</p>{events.map((event) => <article id={event.slug}><h3>{event.year} {event.calendar} — {event.title}</h3><p>{event.summary}</p><div set:html={event.html} />{[...(event.image ? [{image: event.image, alt: event.imageAlt ?? event.title, caption: undefined}] : []), ...(event.gallery ?? [])].map(image => <figure><img src={withBase(image.image, base)} alt={image.alt} loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</article>)}</section></noscript>
  </body>
</html>
