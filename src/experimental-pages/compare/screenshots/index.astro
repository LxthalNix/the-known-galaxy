---
import type { ImageMetadata } from 'astro';
import { withBase } from '../../../utils/paths';
import '../../../styles/experiment/fonts.css';
const files = import.meta.glob<ImageMetadata>('../../../../docs/experiment/screenshots/*.jpg', { eager: true, import: 'default' });
const groups = [
  { title: 'Desktop · 1440px viewport', suffix: '1440' },
  { title: 'Tablet · 1024px viewport', suffix: '1024' },
  { title: 'Mobile · 390px viewport', suffix: '390' },
  { title: 'Expanded historical record · desktop', suffix: 'record-1440' },
];
const base = import.meta.env.BASE_URL;
const galleryExample = files['../../../../docs/experiment/screenshots/concept-a-gallery-1440.jpg'];
function screenshot(concept: string, suffix: string) { return files[`../../../../docs/experiment/screenshots/concept-${concept}-${suffix}.jpg`]; }
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>TKG — Experiment screenshots</title></head><body><main>
  <a href={withBase('compare/', base)}>← Back to live comparison</a><h1>Timeline experiments</h1><p>Neutral perspective, Ubuntu interface and Source Serif 4 headings. Browser scrollbar space accounts for the slightly narrower image widths.</p>
  <section><h2>Revised A · image-first record and gallery</h2><p>A's styling with B's record composition. This explicitly synthetic example uses three supplied interface references. <a href={`${withBase('concept-a/',base)}?demo=gallery#fixture-major`}>Open the interactive gallery example →</a></p><img src={galleryExample.src} width={galleryExample.width} height={galleryExample.height} loading="lazy" alt="Revised Concept A record with a large cover, two additional gallery thumbnails, narrative and metadata below" /></section>
  <p>The following captures document the initial A/B comparison using real records, before the revised A record above.</p>
  {groups.map(group => <section><h2>{group.title}</h2><div class:list={['pair', { mobile: group.suffix === '390' }]}>{['a','b'].map(concept => { const image = screenshot(concept, group.suffix); return <figure><figcaption>Concept {concept.toUpperCase()}</figcaption><a href={image.src} aria-label={`Open full-size Concept ${concept.toUpperCase()} ${group.title} screenshot`}><img src={image.src} width={image.width} height={image.height} loading="lazy" alt={`Concept ${concept.toUpperCase()} ${group.title}`} /></a></figure>; })}</div></section>)}
</main></body></html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#06090d;color:#e8edf2;font-family:Ubuntu,'Segoe UI',sans-serif}main{max-width:1500px;margin:auto;padding:40px 24px}a{color:#a6c9ec}a:focus-visible{outline:2px solid #8fc2ff;outline-offset:5px}h1,h2{font-family:'Source Serif 4',Georgia,serif;font-weight:400}h1{font-size:40px}h2{font-size:27px;margin-top:44px}p{color:#bbc8d4;max-width:800px;line-height:1.7}.pair{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}figure{margin:0}figcaption{margin:0 0 12px;color:#b5c7d6}img{display:block;width:100%;height:auto;border:1px solid #293743}.mobile{max-width:780px}@media(max-width:650px){.pair{grid-template-columns:1fr}.mobile{max-width:375px}}
</style>
